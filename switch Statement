$day = "Monday";

switch ($day) {
    case "Monday":
        echo "It is the start of the school week.";
        break;

    case "Wednesday":
        echo "It is the middle of the school week.";
        break;

    case "Friday":
        echo "It is almost the weekend!";
        break;

    case "Saturday":
        echo "It is the weekend.";
        break;

    default:
        echo "It is a regular school day.";
}

